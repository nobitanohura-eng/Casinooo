# ==============================================================================
# PAPA TRANSPORT LEADS — ENVIRONMENT CONFIGURATION TEMPLATE
# Ready for instant 1-click deployment on Render.com or any Node.js host.
# Zero external database (Supabase) required — works 100% standalone!
# ==============================================================================

# Standalone Security PIN & Password (for Papa on Android phone)
ADMIN_PIN=1234
ADMIN_PASSWORD=papa123
SESSION_SECRET=your-secret-session-key-change-in-production

# Resend Email Delivery Credentials (Server-only)
RESEND_API_KEY=re_123456789abcdef
# Must be an email address from a verified domain in Resend (e.g. outreach@papatransport.com)
RESEND_FROM_EMAIL=transport@your-verified-domain.com
# Optional: Resend Webhook signing secret for webhook verification
RESEND_WEBHOOK_SECRET=whsec_abcdef123456789

# Application Base URL (Used for generating secure unsubscribe links)
NEXT_PUBLIC_APP_URL=https://your-app.onrender.com
APP_BASE_URL=https://your-app.onrender.com

# User Allowlist (Optional: Comma-separated emails authorized to sign in)
APP_ALLOWED_EMAILS=owner@papatransport.com,family@papatransport.com

# Global Safety Kill-Switch for Outbound Email Sending
# Set to true to immediately halt all email transmission globally
GLOBAL_EMAIL_PAUSED=true
